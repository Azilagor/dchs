[Unit]
Description=MCHS FastAPI Directory
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/mchs_fastapi_directory
Environment="PATH=/var/www/mchs_fastapi_directory/.venv/bin"
EnvironmentFile=/var/www/mchs_fastapi_directory/.env
ExecStart=/var/www/mchs_fastapi_directory/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
